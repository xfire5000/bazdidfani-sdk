{
    "name": "bazdidfani/laravel-api-client",
    "description": "Laravel client for the Bazdidfani technical inspection and self-statement webservice API.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "bazdidfani",
        "technical-inspection",
        "self-statement"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Bazdidfani\\ApiClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bazdidfani\\ApiClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bazdidfani\\ApiClient\\BazdidfaniApiClientServiceProvider"
            ],
            "aliases": {
                "BazdidfaniApi": "Bazdidfani\\ApiClient\\Facades\\BazdidfaniApi"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
